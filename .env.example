# Required by NCBI's usage policy for the PubMed/Entrez API
ENTREZ_EMAIL=your_email@example.com

# Optional — raises the PubMed rate limit from 3 to 10 requests/sec.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
ENTREZ_API_KEY=

# Any model you have pulled in Ollama (`ollama list`)
LLM_MODEL=qwen2.5:7b-instruct

# Optional — transcribe audio with Groq's hosted Whisper (much more accurate
# and faster). Free key at https://console.groq.com/keys. Leave empty to use
# local faster-whisper only.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local fallback model: tiny / base / small / medium / large-v3-turbo
LOCAL_WHISPER_MODEL=base

# Where ChromaDB persists the evidence index
CHROMA_DIR=./chroma_store
